{
  "name": "@acme/vue-app",
  "version": "0.0.0",
  "private": true,
  "description": "A Vue application on ACME's design system, as a product team would write it: a form of acme-text-field bound with v-model. Built and tested against the archives of ACME and the base: run `npm run example` from the repository root. `overrides` points ACME's dependencies to the base's archives, which a registry would provide.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "node test/smoke.mjs"
  },
  "dependencies": {
    "@acme/design-system": "file:.base/acme-design-system-0.0.0.tgz",
    "lit": "^3.3.3",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "@unicorne/catalog": "file:.base/unicorne-catalog-0.0.0.tgz",
    "@unicorne/cli": "file:.base/unicorne-cli-0.0.0.tgz",
    "@unicorne/components": "file:.base/unicorne-components-0.0.0.tgz",
    "@unicorne/icons": "file:.base/unicorne-icons-0.0.0.tgz",
    "@unicorne/mcp": "file:.base/unicorne-mcp-0.0.0.tgz",
    "@unicorne/tokens": "file:.base/unicorne-tokens-0.0.0.tgz"
  }
}
