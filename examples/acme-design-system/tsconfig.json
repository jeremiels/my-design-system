{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Lit's legacy decorators, as in the base library.
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    // src/docs.ts runs in Node: ACME's documentation tools.
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src"]
}
