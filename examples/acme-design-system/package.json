{
  "name": "@acme/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Example brand design system built on @unicorne/tokens and @unicorne/components (ADR 0001, ADR 0003): run `npm run example` from the repository root.",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/define.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./styles.css": "./dist/styles.css",
    "./reset.css": "./dist/reset.css",
    "./custom-elements.json": "./custom-elements.json"
  },
  "scripts": {
    "build": "tz build && vite build && tsc -p tsconfig.build.json && cem analyze",
    "test": "node test/smoke.mjs"
  },
  "dependencies": {
    "@unicorne/components": "file:.base/unicorne-components-0.0.0.tgz",
    "@unicorne/tokens": "file:.base/unicorne-tokens-0.0.0.tgz"
  },
  "peerDependencies": {
    "lit": "^3.3.3"
  },
  "customElements": "custom-elements.json"
}
