{
  "name": "@acme/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Example brand design system built on @unicorne/tokens, @unicorne/icons and @unicorne/components (ADR 0001, ADR 0003, ADR 0005), with its own documentation tools, `acme` and `acme-mcp` (ADR 0039): run `npm run example` from the repository root.",
  "bin": {
    "acme": "./bin/acme.js",
    "acme-mcp": "./bin/acme-mcp.js"
  },
  "files": [
    "dist",
    "bin",
    "custom-elements.json",
    "token-manifest.json",
    "icon-manifest.json",
    "design-system.dsds.yaml",
    "src/components/*/*.dsds.yaml"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/define.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./docs": {
      "types": "./dist/docs.d.ts",
      "import": "./dist/docs.js"
    },
    "./acme-button": {
      "types": "./dist/components/acme-button/acme-button.d.ts",
      "import": "./dist/acme-button.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./vue": {
      "types": "./dist/vue.d.ts"
    },
    "./reset.css": "./dist/reset.css",
    "./custom-elements.json": "./custom-elements.json"
  },
  "scripts": {
    "build": "tz build && unicorne-icons icons --out src/icons --export acmeIcons --manifest icon-manifest.json && vite build && tsc -p tsconfig.build.json && cem analyze",
    "test": "node test/smoke.mjs"
  },
  "dependencies": {
    "@unicorne/catalog": "file:.base/unicorne-catalog-0.0.0.tgz",
    "@unicorne/cli": "file:.base/unicorne-cli-0.0.0.tgz",
    "@unicorne/components": "file:.base/unicorne-components-0.0.0.tgz",
    "@unicorne/icons": "file:.base/unicorne-icons-0.0.0.tgz",
    "@unicorne/mcp": "file:.base/unicorne-mcp-0.0.0.tgz",
    "@unicorne/tokens": "file:.base/unicorne-tokens-0.0.0.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "vue": "^3.5.45"
  },
  "peerDependencies": {
    "lit": "^3.3.3",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "customElements": "custom-elements.json"
}
