{
  "name": "@unicorne/components",
  "version": "0.0.0",
  "private": true,
  "description": "The web components of the base, built with Lit: classes without registration, a registration helper, and the tooling brands extend them with (ADR 0001, ADR 0003, ADR 0005).",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/define.js",
    "./src/define.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./styles.css": "./dist/styles.css",
    "./reset.css": "./dist/reset.css",
    "./custom-elements.json": "./custom-elements.json",
    "./vite-plugin": {
      "types": "./dist/plugins/css-import-attributes.d.ts",
      "import": "./dist/plugins/css-import-attributes.js"
    },
    "./cem-plugin": {
      "types": "./dist/plugins/cem-plugin.d.ts",
      "import": "./dist/plugins/cem-plugin.js"
    },
    "./css-modules": {
      "types": "./dist/css-modules.d.ts"
    },
    "./vue": {
      "types": "./dist/vue.d.ts"
    },
    "./button": {
      "types": "./dist/components/button/button.d.ts",
      "import": "./dist/button.js"
    },
    "./button-link": {
      "types": "./dist/components/button-link/button-link.d.ts",
      "import": "./dist/button-link.js"
    },
    "./alert": {
      "types": "./dist/components/alert/alert.d.ts",
      "import": "./dist/alert.js"
    },
    "./modal": {
      "types": "./dist/components/modal/modal.d.ts",
      "import": "./dist/modal.js"
    },
    "./icon": {
      "types": "./dist/components/icon/icon.d.ts",
      "import": "./dist/icon.js"
    },
    "./text-field": {
      "types": "./dist/components/text-field/text-field.d.ts",
      "import": "./dist/text-field.js"
    },
    "./textarea": {
      "types": "./dist/components/textarea/textarea.d.ts",
      "import": "./dist/textarea.js"
    },
    "./autocomplete": {
      "types": "./dist/components/autocomplete/autocomplete.d.ts",
      "import": "./dist/autocomplete.js"
    },
    "./checkbox": {
      "types": "./dist/components/checkbox/checkbox.d.ts",
      "import": "./dist/checkbox.js"
    },
    "./switch": {
      "types": "./dist/components/switch/switch.d.ts",
      "import": "./dist/switch.js"
    },
    "./radio": {
      "types": "./dist/components/radio/radio.d.ts",
      "import": "./dist/radio.js"
    },
    "./radio-group": {
      "types": "./dist/components/radio-group/radio-group.d.ts",
      "import": "./dist/radio-group.js"
    },
    "./checkbox-group": {
      "types": "./dist/components/checkbox-group/checkbox-group.d.ts",
      "import": "./dist/checkbox-group.js"
    },
    "./select": {
      "types": "./dist/components/select/select.d.ts",
      "import": "./dist/select.js"
    },
    "./number-field": {
      "types": "./dist/components/number-field/number-field.d.ts",
      "import": "./dist/number-field.js"
    },
    "./date-field": {
      "types": "./dist/components/date-field/date-field.d.ts",
      "import": "./dist/date-field.js"
    },
    "./slider": {
      "types": "./dist/components/slider/slider.d.ts",
      "import": "./dist/slider.js"
    },
    "./tab": {
      "types": "./dist/components/tab/tab.d.ts",
      "import": "./dist/tab.js"
    },
    "./tab-panel": {
      "types": "./dist/components/tab-panel/tab-panel.d.ts",
      "import": "./dist/tab-panel.js"
    },
    "./tabs": {
      "types": "./dist/components/tabs/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./details": {
      "types": "./dist/components/details/details.d.ts",
      "import": "./dist/details.js"
    },
    "./breadcrumb": {
      "types": "./dist/components/breadcrumb/breadcrumb.d.ts",
      "import": "./dist/breadcrumb.js"
    },
    "./breadcrumb-item": {
      "types": "./dist/components/breadcrumb-item/breadcrumb-item.d.ts",
      "import": "./dist/breadcrumb-item.js"
    },
    "./pagination": {
      "types": "./dist/components/pagination/pagination.d.ts",
      "import": "./dist/pagination.js"
    },
    "./toolbar": {
      "types": "./dist/components/toolbar/toolbar.d.ts",
      "import": "./dist/toolbar.js"
    },
    "./menu": {
      "types": "./dist/components/menu/menu.d.ts",
      "import": "./dist/menu.js"
    },
    "./menu-item": {
      "types": "./dist/components/menu-item/menu-item.d.ts",
      "import": "./dist/menu-item.js"
    },
    "./drawer": {
      "types": "./dist/components/drawer/drawer.d.ts",
      "import": "./dist/drawer.js"
    },
    "./popover": {
      "types": "./dist/components/popover/popover.d.ts",
      "import": "./dist/popover.js"
    },
    "./tooltip": {
      "types": "./dist/components/tooltip/tooltip.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./toaster": {
      "types": "./dist/components/toaster/toaster.d.ts",
      "import": "./dist/toaster.js"
    }
  },
  "scripts": {
    "build": "npm run tokens && npm run analyze && vite build && tsc -p tsconfig.build.json && tsc -p tsconfig.plugin.json && cp src/css-modules.d.ts dist/",
    "analyze": "NODE_OPTIONS=--conditions=@unicorne/source cem analyze",
    "tokens": "tz build && oxfmt src/components/*/*.tokens.css src/bases/*/*.tokens.css src/controllers/*.tokens.css",
    "tokens:check": "npm run tokens && git diff --exit-code -- 'src/*.tokens.css'",
    "api:check": "npm run analyze && git diff --exit-code -- custom-elements.json",
    "prepack": "node ../../scripts/pack-manifest.mjs prepack",
    "postpack": "node ../../scripts/pack-manifest.mjs postpack"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "invokers-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@unicorne/icons": "0.0.0",
    "@unicorne/tokens": "0.0.0"
  },
  "peerDependencies": {
    "@unicorne/icons": "^0.0.0",
    "@unicorne/tokens": "^0.0.0",
    "lit": "^3.3.3",
    "vite": "^8.3.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "customElements": "custom-elements.json"
}
