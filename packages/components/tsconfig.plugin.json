{
  // Builds plugins/ (Node code, e.g. the CSS module scripts Vite plugin) into
  // dist/plugins for brand design systems: `@unicorne/components/vite-plugin`
  // and `@unicorne/components/cem-plugin`. Build @unicorne/tokens first:
  // cem-plugin imports it.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    // Types come from the built packages, not from their sources.
    "customConditions": [],
    "rootDir": "plugins",
    "outDir": "dist/plugins"
  },
  "include": ["plugins"],
  "exclude": ["plugins/**/*.test.ts"]
}
