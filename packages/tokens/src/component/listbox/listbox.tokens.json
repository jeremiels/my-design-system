{
  "listbox": {
    "$description": "Tokens of the lists of options: the listbox of `autocomplete` (`withListbox`).",
    "background-color": {
      "$type": "color",
      "$value": "{color.surface.default}",
      "$description": "Background color of the list."
    },
    "border-color": {
      "$type": "color",
      "$value": "{color.border.default}",
      "$description": "Border color of the list."
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border.width}",
      "$description": "Border width of the list."
    },
    "border-radius": {
      "$type": "dimension",
      "$value": "{radius.md}",
      "$description": "Corner radius of the list."
    },
    "shadow": {
      "$type": "shadow",
      "$value": "{shadow.raised}",
      "$description": "Shadow of the list, above the page."
    },
    "padding": {
      "$type": "dimension",
      "$value": "{spacing.2xs}",
      "$description": "Padding of the list, around its options."
    },
    "max-block-size": {
      "$type": "dimension",
      "$value": "{size.popup}",
      "$description": "Largest height of the list: its options scroll past it."
    },
    "option-padding-inline": {
      "$type": "dimension",
      "$value": "{spacing.sm}",
      "$description": "Horizontal padding of an option."
    },
    "option-padding-block": {
      "$type": "dimension",
      "$value": "{spacing.xs}",
      "$description": "Vertical padding of an option."
    },
    "option-border-radius": {
      "$type": "dimension",
      "$value": "{radius.sm}",
      "$description": "Corner radius of an option."
    },
    "option-background-color-active": {
      "$type": "color",
      "$value": "{color.action.background}",
      "$description": "Background color of the active option: the one the arrow keys or the pointer are on."
    },
    "option-text-color-active": {
      "$type": "color",
      "$value": "{color.action.text}",
      "$description": "Text color of the active option."
    },
    "option-opacity-disabled": {
      "$type": "number",
      "$value": "{opacity.disabled}",
      "$description": "Opacity of a disabled option."
    }
  }
}
