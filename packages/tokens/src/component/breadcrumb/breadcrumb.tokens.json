{
  "breadcrumb": {
    "$description": "Tokens of `breadcrumb` and of its `breadcrumb-item`: the links and the separators.",
    "gap": {
      "$type": "dimension",
      "$value": "{spacing.sm}",
      "$description": "Space between a link and a separator."
    },
    "font-family": {
      "$type": "fontFamily",
      "$value": "{font.family.body}",
      "$description": "Font family."
    },
    "font-size": {
      "$type": "dimension",
      "$value": "{font.size.sm}",
      "$description": "Font size."
    },
    "link-color": {
      "$type": "color",
      "$value": "{color.action.background}",
      "$description": "Color of a link."
    },
    "current-color": {
      "$type": "color",
      "$value": "{color.text.default}",
      "$description": "Color of the current page."
    },
    "separator-color": {
      "$type": "color",
      "$value": "{color.border.control}",
      "$description": "Color of the separator."
    },
    "separator-size": {
      "$type": "dimension",
      "$value": "{spacing.xs}",
      "$description": "Width and height of the separator, a chevron."
    },
    "separator-width": {
      "$type": "dimension",
      "$value": "{border.width}",
      "$description": "Stroke of the separator."
    },
    "focus-ring-color": {
      "$type": "color",
      "$value": "{color.focus-ring}",
      "$description": "Color of the focus ring."
    },
    "focus-ring-width": {
      "$type": "dimension",
      "$value": "{focus-ring.width}",
      "$description": "Width of the focus ring."
    },
    "focus-ring-offset": {
      "$type": "dimension",
      "$value": "{focus-ring.offset}",
      "$description": "Space between a link and its focus ring."
    }
  }
}
