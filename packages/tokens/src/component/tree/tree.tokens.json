{
  "tree": {
    "$description": "Tokens of `tree` and of its `tree-item`: the rows, their indent and their states.",
    "font-family": {
      "$type": "fontFamily",
      "$value": "{font.family.body}",
      "$description": "Font family."
    },
    "font-size": {
      "$type": "dimension",
      "$value": "{font.size.md}",
      "$description": "Font size."
    },
    "text-color": {
      "$type": "color",
      "$value": "{color.text.default}",
      "$description": "Text color."
    },
    "indent": {
      "$type": "dimension",
      "$value": "{spacing.md}",
      "$description": "Indent of each level."
    },
    "gap": {
      "$type": "dimension",
      "$value": "{spacing.xs}",
      "$description": "Space between the chevron and the label."
    },
    "row-padding-inline": {
      "$type": "dimension",
      "$value": "{spacing.sm}",
      "$description": "Horizontal padding of a row."
    },
    "row-padding-block": {
      "$type": "dimension",
      "$value": "{spacing.xs}",
      "$description": "Vertical padding of a row."
    },
    "row-border-radius": {
      "$type": "dimension",
      "$value": "{radius.sm}",
      "$description": "Corner radius of a row."
    },
    "row-background-color-hover": {
      "$type": "color",
      "$value": "{color.surface.raised}",
      "$description": "Background color of a row under the pointer."
    },
    "selected-background-color": {
      "$type": "color",
      "$value": "{color.action.background}",
      "$description": "Background color of the chosen row."
    },
    "selected-text-color": {
      "$type": "color",
      "$value": "{color.action.text}",
      "$description": "Text color of the chosen row."
    },
    "chevron-size": {
      "$type": "dimension",
      "$value": "{spacing.sm}",
      "$description": "Width and height of the chevron of an item with children."
    },
    "chevron-width": {
      "$type": "dimension",
      "$value": "{border.width}",
      "$description": "Stroke of the chevron. Twice this width."
    },
    "focus-ring-color": {
      "$type": "color",
      "$value": "{color.focus-ring}",
      "$description": "Color of the focus ring."
    },
    "focus-ring-width": {
      "$type": "dimension",
      "$value": "{focus-ring.width}",
      "$description": "Width of the focus ring."
    },
    "focus-ring-offset": {
      "$type": "dimension",
      "$value": "{focus-ring.offset}",
      "$description": "Space between a row and its focus ring, inside it."
    }
  }
}
