{
  "file-field": {
    "$description": "Tokens of `file-field`, besides those of the fields (`field`).",
    "button-background-color": {
      "$type": "color",
      "$value": "{color.surface.default}",
      "$description": "Background color of the button that opens the file picker."
    },
    "button-background-color-hover": {
      "$type": "color",
      "$value": "{color.surface.raised}",
      "$description": "Background color of the button under the pointer."
    },
    "button-text-color": {
      "$type": "color",
      "$value": "{color.text.default}",
      "$description": "Text color of the button."
    },
    "button-border-color": {
      "$type": "color",
      "$value": "{color.border.control}",
      "$description": "Border color of the button."
    },
    "button-border-radius": {
      "$type": "dimension",
      "$value": "{radius.md}",
      "$description": "Corner radius of the button."
    },
    "button-padding-inline": {
      "$type": "dimension",
      "$value": "{spacing.sm}",
      "$description": "Horizontal padding of the button."
    },
    "button-padding-block": {
      "$type": "dimension",
      "$value": "{spacing.xs}",
      "$description": "Vertical padding of the button."
    },
    "button-gap": {
      "$type": "dimension",
      "$value": "{spacing.sm}",
      "$description": "Space between the button and the names of the files."
    }
  }
}
