{
  "popup": {
    "$description": "Tokens of the popups anchored to a trigger (`PopupBase`): the trigger, its chevron, the popup's distance and transitions. `menu` and `popover` add their panel.",
    "font-family": {
      "$type": "fontFamily",
      "$value": "{font.family.body}",
      "$description": "Font family."
    },
    "font-size": {
      "$type": "dimension",
      "$value": "{font.size.md}",
      "$description": "Font size."
    },
    "text-color": {
      "$type": "color",
      "$value": "{color.text.default}",
      "$description": "Text color of the trigger."
    },
    "trigger-padding-inline": {
      "$type": "dimension",
      "$value": "{spacing.md}",
      "$description": "Horizontal padding of the trigger."
    },
    "trigger-padding-block": {
      "$type": "dimension",
      "$value": "{spacing.sm}",
      "$description": "Vertical padding of the trigger."
    },
    "trigger-gap": {
      "$type": "dimension",
      "$value": "{spacing.sm}",
      "$description": "Space between the label of the trigger and its chevron."
    },
    "trigger-background-color": {
      "$type": "color",
      "$value": "{color.surface.default}",
      "$description": "Background color of the trigger."
    },
    "trigger-background-color-hover": {
      "$type": "color",
      "$value": "{color.secondary.background-hover}",
      "$description": "Background color of the trigger under the pointer."
    },
    "trigger-border-width": {
      "$type": "dimension",
      "$value": "{border.width}",
      "$description": "Border width of the trigger."
    },
    "trigger-border-color": {
      "$type": "color",
      "$value": "{color.border.control}",
      "$description": "Border color of the trigger."
    },
    "trigger-border-radius": {
      "$type": "dimension",
      "$value": "{radius.md}",
      "$description": "Corner radius of the trigger."
    },
    "chevron-size": {
      "$type": "dimension",
      "$value": "{spacing.sm}",
      "$description": "Width and height of the chevron. Its stroke is twice the border's width."
    },
    "popup-offset": {
      "$type": "dimension",
      "$value": "{spacing.2xs}",
      "$description": "Space between the trigger and the popup."
    },
    "transition-duration": {
      "$type": "duration",
      "$value": "{motion.duration.fast}",
      "$description": "Entry and exit transition duration of the popup. Zero with reduced motion."
    },
    "transition-timing-function": {
      "$type": "cubicBezier",
      "$value": "{motion.easing.standard}",
      "$description": "Entry and exit transition easing of the popup."
    },
    "focus-ring-color": {
      "$type": "color",
      "$value": "{color.focus-ring}",
      "$description": "Color of the focus ring."
    },
    "focus-ring-width": {
      "$type": "dimension",
      "$value": "{focus-ring.width}",
      "$description": "Width of the focus ring."
    },
    "focus-ring-offset": {
      "$type": "dimension",
      "$value": "{focus-ring.offset}",
      "$description": "Space between the trigger and its focus ring."
    }
  }
}
