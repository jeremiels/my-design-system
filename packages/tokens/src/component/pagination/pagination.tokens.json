{
  "pagination": {
    "$description": "Tokens of `pagination`: its buttons and the current page.",
    "gap": {
      "$type": "dimension",
      "$value": "{spacing.2xs}",
      "$description": "Space between two buttons."
    },
    "font-family": {
      "$type": "fontFamily",
      "$value": "{font.family.body}",
      "$description": "Font family."
    },
    "font-size": {
      "$type": "dimension",
      "$value": "{font.size.md}",
      "$description": "Font size."
    },
    "text-color": {
      "$type": "color",
      "$value": "{color.text.default}",
      "$description": "Text color of the buttons."
    },
    "button-size": {
      "$type": "dimension",
      "$value": "{size.icon}",
      "$description": "Smallest width and height of a button."
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{spacing.sm}",
      "$description": "Horizontal padding of a button."
    },
    "border-radius": {
      "$type": "dimension",
      "$value": "{radius.md}",
      "$description": "Corner radius of a button."
    },
    "hover-background-color": {
      "$type": "color",
      "$value": "{color.secondary.background-hover}",
      "$description": "Background color of a button under the pointer."
    },
    "current-background-color": {
      "$type": "color",
      "$value": "{color.action.background}",
      "$description": "Background color of the current page."
    },
    "current-text-color": {
      "$type": "color",
      "$value": "{color.action.text}",
      "$description": "Text color of the current page."
    },
    "chevron-size": {
      "$type": "dimension",
      "$value": "{spacing.sm}",
      "$description": "Width and height of the chevrons of the previous and next buttons."
    },
    "chevron-width": {
      "$type": "dimension",
      "$value": "{border.width}",
      "$description": "Stroke of the chevrons. Twice this width."
    },
    "focus-ring-color": {
      "$type": "color",
      "$value": "{color.focus-ring}",
      "$description": "Color of the focus ring."
    },
    "focus-ring-width": {
      "$type": "dimension",
      "$value": "{focus-ring.width}",
      "$description": "Width of the focus ring."
    },
    "focus-ring-offset": {
      "$type": "dimension",
      "$value": "{focus-ring.offset}",
      "$description": "Space between a button and its focus ring."
    }
  }
}
