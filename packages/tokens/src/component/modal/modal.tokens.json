{
  "modal": {
    "$description": "Tokens of `modal`.",
    "background-color": {
      "$type": "color",
      "$value": "{color.surface.raised}",
      "$description": "Content background color."
    },
    "border-radius": {
      "$type": "dimension",
      "$value": "{radius.lg}",
      "$description": "Corner radius."
    },
    "padding": {
      "$type": "dimension",
      "$value": "{spacing.md}",
      "$description": "Content padding."
    },
    "gap": {
      "$type": "dimension",
      "$value": "{spacing.sm}",
      "$description": "Space between the content and the close button."
    },
    "heading-font-size": {
      "$type": "dimension",
      "$value": "{font.size.lg}",
      "$description": "Font size of the title, `label`."
    },
    "heading-font-weight": {
      "$type": "fontWeight",
      "$value": "{font.weight.semibold}",
      "$description": "Font weight of the title."
    },
    "close-button-padding": {
      "$type": "dimension",
      "$value": "{spacing.xs}",
      "$description": "Padding of the close button around its icon, the same on every side: a square button."
    },
    "backdrop-color": {
      "$type": "color",
      "$value": "{color.backdrop}",
      "$description": "Backdrop color."
    },
    "shadow": {
      "$type": "shadow",
      "$value": "{shadow.overlay}",
      "$description": "Dialog shadow."
    },
    "scale-closed": {
      "$type": "number",
      "$value": "{motion.scale.enter}",
      "$description": "Scale of the closed dialog: its entry starts there and its exit ends there. One with reduced motion."
    },
    "transition-duration": {
      "$type": "duration",
      "$value": "{motion.duration.base}",
      "$description": "Entry and exit transition duration, of the dialog and its backdrop. Zero with reduced motion."
    },
    "transition-timing-function": {
      "$type": "cubicBezier",
      "$value": "{motion.easing.standard}",
      "$description": "Entry and exit transition easing."
    }
  }
}
