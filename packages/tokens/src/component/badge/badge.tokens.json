{
  "badge": {
    "$description": "Tokens of `badge`. The defaults are those of the `information` variant.",
    "background-color": {
      "$type": "color",
      "$value": "{color.information.background}",
      "$description": "Background color (variants change the default)."
    },
    "text-color": {
      "$type": "color",
      "$value": "{color.information.text}",
      "$description": "Text color (variants change the default)."
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{spacing.xs}",
      "$description": "Horizontal padding."
    },
    "padding-block": {
      "$type": "dimension",
      "$value": "{spacing.2xs}",
      "$description": "Vertical padding."
    },
    "border-radius": {
      "$type": "dimension",
      "$value": "{radius.sm}",
      "$description": "Corner radius."
    },
    "font-family": {
      "$type": "fontFamily",
      "$value": "{font.family.body}",
      "$description": "Font family."
    },
    "font-size": {
      "$type": "dimension",
      "$value": "{font.size.sm}",
      "$description": "Font size."
    },
    "font-weight": {
      "$type": "fontWeight",
      "$value": "{font.weight.semibold}",
      "$description": "Font weight."
    }
  }
}
