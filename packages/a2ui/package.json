{
  "name": "@unicorne/a2ui",
  "version": "0.0.0",
  "private": true,
  "description": "Interfaces generated by an agent, with A2UI (ADR 0052): the A2UI catalog of a design system, generated from its documentation, and the adapters that render its components in an A2UI surface. A design system extends the base's mappings with its own.",
  "files": [
    "dist",
    "a2ui-catalog.json"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@unicorne/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./document": {
      "@unicorne/source": "./src/document.ts",
      "types": "./dist/document.d.ts",
      "import": "./dist/document.js"
    },
    "./a2ui-catalog.json": "./a2ui-catalog.json"
  },
  "scripts": {
    "a2ui": "node --conditions=@unicorne/source plugins/write-document.ts && oxfmt a2ui-catalog.json",
    "a2ui:check": "npm run a2ui && git diff --exit-code -- a2ui-catalog.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/pack-manifest.mjs prepack",
    "postpack": "node ../../scripts/pack-manifest.mjs postpack"
  },
  "devDependencies": {
    "@a2ui/lit": "0.15.0",
    "@a2ui/web_core": "0.15.0"
  },
  "peerDependencies": {
    "@a2ui/web_core": "0.15.0",
    "@unicorne/catalog": "0.0.0",
    "@unicorne/components": "0.0.0",
    "lit": "^3.3.3"
  },
  "peerDependenciesMeta": {
    "@a2ui/web_core": {
      "optional": true
    },
    "@unicorne/catalog": {
      "optional": true
    }
  }
}
