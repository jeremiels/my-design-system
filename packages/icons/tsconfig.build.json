{
  // Builds plugins/ (Node code: the `unicorne-icons` command and
  // `@unicorne/icons/icon-set`) into dist/, with their types. The icons
  // themselves (js/, svg/) are generated by `npm run icons` and committed.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    // Types come from the built packages, not from their sources.
    "customConditions": [],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["plugins"],
  "exclude": ["**/*.test.ts"]
}
