{
  "name": "@unicorne/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "The MCP server of a design system's documentation (ADR 0039): tools that list, show, search and check its components, and its tokens (ADR 0042), for agents. `unicorne-mcp` serves the base's; a design system builds its own with `createMcpServer()`.",
  "bin": {
    "unicorne-mcp": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@unicorne/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/pack-manifest.mjs prepack",
    "postpack": "node ../../scripts/pack-manifest.mjs postpack"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@unicorne/catalog": "0.0.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=26"
  }
}
