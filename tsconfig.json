{
  // The whole monorepo, type-checked at once (`npm run check`). The packages'
  // build configs (packages/*/tsconfig.*.json) extend it.
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // Plugins import each other as .ts: Node runs them as-is (the manifest
    // config), tsconfig.plugin.json rewrites the extensions when building.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    // A package imports another from its TypeScript sources, without building
    // it first (ADR 0003). The build configs turn this off.
    "customConditions": ["@unicorne/source"],
    // The stories import the root's Storybook preview (CSF Factories).
    "paths": { "#.storybook/*": ["./.storybook/*"] },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    ".storybook",
    "packages/components/src",
    "packages/components/plugins",
    "packages/tokens/plugins",
    "packages/tokens/testing"
  ]
}
