{
  "name": "my-design-system",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx",
      "./*.js",
      "./*.jsx"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./button": {
      "types": "./dist/components/button/button.d.ts",
      "import": "./dist/button.js"
    },
    "./button-link": {
      "types": "./dist/components/button/button-link.d.ts",
      "import": "./dist/button-link.js"
    },
    "./alert": {
      "types": "./dist/components/alert/alert.d.ts",
      "import": "./dist/alert.js"
    },
    "./modal": {
      "types": "./dist/components/modal/modal.d.ts",
      "import": "./dist/modal.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "oxlint src --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "compat": "npm run build && es-check checkBrowser \"dist/**/*.js\" --module --checkFeatures && node scripts/check-css-compat.mjs",
    "test:legacy": "npm run build && node tests/legacy/run.mjs"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/web-components-vite": "^10.6.7",
    "@types/node": "^26.6.6",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "browserslist": "^4.29.5",
    "browserslist-to-esbuild": "^2.1.1",
    "doiuse": "^6.0.6",
    "es-check": "^9.8.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "storybook": "^10.6.7",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "webdriverio": "^10.1.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 115",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "Firefox ESR"
  ],
  "engines": {
    "node": ">=24.8.0",
    "npm": ">=11.6.0"
  }
}
