{
  "name": "my-design-system",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/define.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx",
      "./*.js",
      "./*.jsx"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./styles.css": "./dist/styles.css",
    "./reset.css": "./dist/reset.css",
    "./custom-elements.json": "./custom-elements.json",
    "./vite-plugin": {
      "types": "./dist/plugins/css-import-attributes.d.ts",
      "import": "./dist/plugins/css-import-attributes.js"
    },
    "./css-modules": {
      "types": "./dist/css-modules.d.ts"
    },
    "./button": {
      "types": "./dist/components/button/button.d.ts",
      "import": "./dist/button.js"
    },
    "./button-link": {
      "types": "./dist/components/button/button-link.d.ts",
      "import": "./dist/button-link.js"
    },
    "./alert": {
      "types": "./dist/components/alert/alert.d.ts",
      "import": "./dist/alert.js"
    },
    "./modal": {
      "types": "./dist/components/modal/modal.d.ts",
      "import": "./dist/modal.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run analyze && vite build && tsc -p tsconfig.build.json && tsc -p tsconfig.plugin.json && cp src/css-modules.d.ts dist/",
    "preview": "vite preview",
    "storybook": "npm run analyze && storybook dev -p 6006",
    "build-storybook": "npm run analyze && storybook build",
    "analyze": "cem analyze",
    "api:check": "cem analyze && git diff --exit-code -- custom-elements.json",
    "check": "oxlint src && oxfmt --check && tsc -p tsconfig.json --noEmit && npm run api:check && vitest run",
    "lint": "oxlint src --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "compat": "npm run build && es-check checkBrowser \"dist/**/*.js\" --module --checkFeatures && node scripts/check-css-compat.mjs",
    "test:legacy": "npm run build && node tests/legacy/run.mjs",
    "example": "node scripts/run-example.mjs",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@chromatic-com/storybook": "^5.6.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/web-components": "^10.6.7",
    "@storybook/web-components-vite": "^10.6.7",
    "@types/node": "^26.6.6",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "browserslist": "^4.29.5",
    "browserslist-to-esbuild": "^2.1.1",
    "doiuse": "^6.0.6",
    "es-check": "^9.8.1",
    "lit": "^3.3.3",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "storybook": "^10.6.7",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "webdriverio": "^10.1.0"
  },
  "peerDependencies": {
    "lit": "^3.3.3",
    "vite": "^8.3.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 115",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "Firefox ESR"
  ],
  "engines": {
    "node": ">=26.13.1",
    "npm": ">=11.20.0"
  },
  "customElements": "custom-elements.json"
}
