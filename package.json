{
  "name": "my-design-system",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "custom-elements.json",
    "tokens/**/*.json"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/define.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx",
      "./*.js",
      "./*.jsx"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./styles.css": "./dist/styles.css",
    "./reset.css": "./dist/reset.css",
    "./custom-elements.json": "./custom-elements.json",
    "./vite-plugin": {
      "types": "./dist/plugins/css-import-attributes.d.ts",
      "import": "./dist/plugins/css-import-attributes.js"
    },
    "./terrazzo-plugin": {
      "types": "./dist/plugins/terrazzo-plugin.d.ts",
      "import": "./dist/plugins/terrazzo-plugin.js"
    },
    "./cem-plugin": {
      "types": "./dist/plugins/cem-plugin.d.ts",
      "import": "./dist/plugins/cem-plugin.js"
    },
    "./tokens/*": "./tokens/*",
    "./css-modules": {
      "types": "./dist/css-modules.d.ts"
    },
    "./button": {
      "types": "./dist/components/button/button.d.ts",
      "import": "./dist/button.js"
    },
    "./button-link": {
      "types": "./dist/components/button/button-link.d.ts",
      "import": "./dist/button-link.js"
    },
    "./alert": {
      "types": "./dist/components/alert/alert.d.ts",
      "import": "./dist/alert.js"
    },
    "./modal": {
      "types": "./dist/components/modal/modal.d.ts",
      "import": "./dist/modal.js"
    },
    "./testing": {
      "types": "./dist/testing/contrast.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens && npm run analyze && vite build && tsc -p tsconfig.build.json && tsc -p tsconfig.plugin.json && cp src/css-modules.d.ts dist/",
    "preview": "vite preview",
    "storybook": "npm run tokens && npm run analyze && storybook dev -p 6006",
    "build-storybook": "npm run tokens && npm run analyze && storybook build",
    "analyze": "cem analyze",
    "tokens": "tz build && oxfmt src/styles/tokens.css src/components/*/*.tokens.css",
    "tokens:check": "npm run tokens && git diff --exit-code -- src/styles/tokens.css 'src/components/*/*.tokens.css'",
    "api:check": "cem analyze && git diff --exit-code -- custom-elements.json",
    "check": "oxlint src && oxfmt --check && tsc -p tsconfig.json --noEmit && npm run tokens:check && npm run api:check && npm run dsds && vitest run",
    "lint": "oxlint src --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "compat": "npm run build && es-check checkBrowser \"dist/**/*.js\" --module --checkFeatures && node scripts/check-css-compat.mjs",
    "example": "node scripts/run-example.mjs",
    "dsds": "dsds-validate --strict design-system.dsds.yaml src/components/*/*.dsds.yaml && dsds-format --check design-system.dsds.yaml src/components/*/*.dsds.yaml"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/web-components": "^10.6.7",
    "@storybook/web-components-vite": "^10.6.7",
    "@terrazzo/cli": "^2.10.0",
    "@terrazzo/parser": "^2.10.0",
    "@terrazzo/token-tools": "^2.10.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "browserslist": "^4.29.5",
    "browserslist-to-esbuild": "^2.1.1",
    "design-system-documentation-schema": "github:somerandomdude/design-system-documentation-schema#v0.23.1",
    "doiuse": "^6.0.6",
    "es-check": "^9.8.1",
    "lit": "^3.3.3",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "storybook": "^10.6.7",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@terrazzo/cli": "^2.10.0",
    "@terrazzo/token-tools": "^2.10.0",
    "lit": "^3.3.3",
    "vite": "^8.3.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "@terrazzo/cli": {
      "optional": true
    },
    "@terrazzo/token-tools": {
      "optional": true
    }
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "and_chr >= 111",
    "samsung >= 22",
    "opera >= 97",
    "op_mob >= 75",
    "firefox >= 115",
    "and_ff >= 115",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "Firefox ESR"
  ],
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.12.1"
  },
  "customElements": "custom-elements.json"
}
