{
  "name": "unicorne",
  "version": "0.0.0",
  "private": true,
  "description": "The base's monorepo: @unicorne/tokens, @unicorne/icons and @unicorne/components (packages/), their documentation (docs/, Storybook) and the example brand (examples/). See ADR 0003 and ADR 0005.",
  "workspaces": [
    "packages/tokens",
    "packages/icons",
    "packages/components",
    "packages/catalog",
    "packages/cli",
    "packages/mcp"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "storybook": "npm run tokens && npm run analyze && storybook dev -p 6006",
    "build-storybook": "npm run tokens && npm run analyze && storybook build",
    "build": "npm run build --workspaces",
    "tokens": "npm run tokens --workspaces --if-present",
    "icons": "npm run icons -w @unicorne/icons",
    "analyze": "npm run analyze -w @unicorne/components",
    "check": "oxlint packages/components/src packages/catalog/src packages/cli/src packages/mcp/src packages/tokens/testing .storybook && oxfmt --check && tsc -p tsconfig.json --noEmit && npm run tokens:check --workspaces --if-present && npm run icons:check -w @unicorne/icons && npm run api:check -w @unicorne/components && npm run dsds && vitest run",
    "coverage": "COVERAGE=1 vitest run --coverage",
    "lint": "oxlint packages/components/src packages/catalog/src packages/cli/src packages/mcp/src packages/tokens/testing .storybook --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "compat": "npm run build && es-check checkBrowser \"packages/*/dist/**/*.js\" --module --checkFeatures && node scripts/check-css-compat.mjs",
    "example": "node scripts/run-example.mjs",
    "dsds": "dsds-validate --strict packages/components/design-system.dsds.yaml packages/components/src/components/*/*.dsds.yaml && dsds-format --check packages/components/design-system.dsds.yaml packages/components/src/components/*/*.dsds.yaml"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/web-components": "^10.6.7",
    "@storybook/web-components-vite": "^10.6.7",
    "@terrazzo/cli": "^2.10.0",
    "@terrazzo/parser": "^2.10.0",
    "@terrazzo/token-tools": "^2.10.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "browserslist": "^4.29.5",
    "browserslist-to-esbuild": "^2.1.1",
    "design-system-documentation-schema": "github:somerandomdude/design-system-documentation-schema#v0.23.1",
    "doiuse": "^6.0.6",
    "es-check": "^9.8.1",
    "lit": "^3.3.3",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "storybook": "^10.6.7",
    "svgo": "^4.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@lit-labs/ssr": {
      "@types/node": "$@types/node"
    }
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "and_chr >= 111",
    "samsung >= 22",
    "opera >= 97",
    "op_mob >= 75",
    "firefox >= 115",
    "and_ff >= 115",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "Firefox ESR"
  ],
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.12.1"
  }
}
